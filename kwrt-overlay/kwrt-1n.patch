diff --git a/packages/desktop/internal/server/dp_push.go b/packages/desktop/internal/server/dp_push.go
new file mode 100644
index 0000000..bde71b2
--- /dev/null
+++ b/packages/desktop/internal/server/dp_push.go
@@ -0,0 +1,418 @@
+package server
+
+// 1:N 多数据面：统一优选结果的「重新验证 → 分发 → 推送」。
+//
+// ## 约束（逐条对应需求）
+//
+//   - 每个数据面各自独立：重新验证用**它自己的域名 / 路径 / UUID**，推送只写**它自己的池**，
+//     失败只记在它自己的记录里，不影响其它数据面；
+//   - 推送前必须重新验证 TLS + WS：不是它域名下能用的 IP 一个也不会写进它的池；
+//   - 验证后一个可用 IP 都没有时**不写**（尤其 replace 模式，绝不能把原池清空）；
+//   - 失败自动重试（网络错误 / 5xx / 429），业务错误（4xx）不重试；
+//   - 去重由内核完成（append 按 ip:port 去重）；
+//   - 同一时刻只允许一轮推送，避免定时任务与手动操作互相叠加（路由器上尤其重要）。
+
+import (
+	"context"
+	"fmt"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/xmwengxing/cfpilot/packages/desktop/internal/dpreg"
+	"github.com/xmwengxing/cfpilot/packages/desktop/internal/scan"
+	"github.com/xmwengxing/cfpilot/packages/desktop/internal/schedule"
+	"github.com/xmwengxing/cfpilot/packages/desktop/internal/store"
+)
+
+const (
+	dpPushAttempts   = 3
+	dpValidateBudget = 3 * time.Minute
+	dpPushBudget     = 12 * time.Minute
+)
+
+var (
+	dpPushLock sync.Mutex
+	dpStores   sync.Map // dir → *dpreg.Store（同一目录共用一个实例，写入才不会互相覆盖）
+)
+
+// dpPushing 表示当前是否有推送在跑（界面轮询用）。
+var dpPushing struct {
+	sync.Mutex
+	on bool
+}
+
+func (s *Server) dpStore() *dpreg.Store {
+	dir := s.store.DirPath()
+	if v, ok := dpStores.Load(dir); ok {
+		return v.(*dpreg.Store)
+	}
+	v, _ := dpStores.LoadOrStore(dir, dpreg.New(dir))
+	return v.(*dpreg.Store)
+}
+
+// dpPushResult 是单个数据面一次推送的结果。
+type dpPushResult struct {
+	ID       string `json:"id"`
+	Name     string `json:"name"`
+	Domain   string `json:"domain"`
+	Status   string `json:"status"` // ok / failed / skipped
+	Message  string `json:"message"`
+	Checked  int    `json:"checked"`
+	Valid    int    `json:"valid"`
+	Added    int    `json:"added"`
+	Pool     int    `json:"pool"`
+	Attempts int    `json:"attempts"`
+}
+
+// ipLine 是解析后的一行 `IP:Port#备注`。
+type ipLine struct {
+	Raw  string
+	IP   string
+	Port int
+}
+
+// parseIPLine 解析 `1.2.3.4:443#备注` / `[2606::1]:443#备注` / `1.2.3.4`。
+func parseIPLine(raw string) (ipLine, bool) {
+	l := strings.TrimSpace(raw)
+	if l == "" {
+		return ipLine{}, false
+	}
+	core := l
+	if i := strings.Index(core, "#"); i >= 0 {
+		core = strings.TrimSpace(core[:i])
+	}
+	port := 443
+	ip := core
+	if strings.HasPrefix(core, "[") {
+		end := strings.Index(core, "]")
+		if end < 0 {
+			return ipLine{}, false
+		}
+		ip = core[1:end]
+		if rest := core[end+1:]; strings.HasPrefix(rest, ":") {
+			p, err := strconv.Atoi(rest[1:])
+			if err != nil {
+				return ipLine{}, false
+			}
+			port = p
+		}
+	} else if strings.Count(core, ":") == 1 {
+		i := strings.Index(core, ":")
+		p, err := strconv.Atoi(core[i+1:])
+		if err != nil {
+			return ipLine{}, false
+		}
+		ip, port = core[:i], p
+	}
+	if ip == "" || port <= 0 || port > 65535 {
+		return ipLine{}, false
+	}
+	return ipLine{Raw: l, IP: ip, Port: port}, true
+}
+
+// dpControl 取控制面的域名与面板密码。
+func (s *Server) dpControl(ctx context.Context) (string, string, error) {
+	set := s.dpStore().Settings()
+	var profile *store.Profile
+	if set.ControlProfileID != "" {
+		p, err := s.store.Get(set.ControlProfileID)
+		if err != nil || p == nil {
+			return "", "", fmt.Errorf("设置里指定的控制面账号已不存在")
+		}
+		profile = p
+	} else {
+		p, err := s.store.Active()
+		if err != nil || p == nil {
+			return "", "", fmt.Errorf("没有可用的控制面账号，请先添加账号并完成控制面部署")
+		}
+		profile = p
+	}
+	if strings.TrimSpace(profile.CfToken) == "" {
+		return "", "", fmt.Errorf("控制面账号没有 API Token")
+	}
+	manifest, host, password := s.resolvePanelAccess(ctx, profile)
+	if host == "" {
+		return "", "", fmt.Errorf("控制面账号的清单里没有控制面域名，请先完成一次部署")
+	}
+	if password == "" && manifest != nil {
+		password = strings.TrimSpace(manifest.Credentials.PanelPassword)
+	}
+	if password == "" {
+		password = strings.TrimSpace(profile.PanelPassword)
+	}
+	if password == "" {
+		return "", "", fmt.Errorf("找不到控制面的面板密码，请先在部署页填写并保存")
+	}
+	return host, password, nil
+}
+
+// dpRegistryItems 把本地注册表转成控制面需要的描述（不含任何账号凭据）。
+func dpRegistryItems(planes []dpreg.DataPlane) []scan.RegistryItem {
+	items := make([]scan.RegistryItem, 0, len(planes))
+	for _, p := range planes {
+		items = append(items, scan.RegistryItem{
+			ID: p.ID, Name: p.Name, Domain: p.Domain, UUID: p.UUID,
+			WSPath: p.WSPath, TrojanPassword: p.TrojanPassword,
+			TrojanPath: p.TrojanPath, XHTTPPath: p.XHTTPPath, Enabled: p.Enabled,
+		})
+	}
+	return items
+}
+
+// dpSyncRegistry 把注册表同步到控制面（订阅聚合依赖它）。
+func (s *Server) dpSyncRegistry(ctx context.Context) error {
+	host, password, err := s.dpControl(ctx)
+	if err != nil {
+		return err
+	}
+	tok := scan.FetchScannerToken(ctx, host, password, 25*time.Second)
+	if !tok.OK {
+		return fmt.Errorf("获取控制面令牌失败：%s", tok.Error)
+	}
+	res := scan.PutRegistry(ctx, host, tok.Token, dpRegistryItems(s.dpStore().List()), 20*time.Second)
+	if !res.OK {
+		return fmt.Errorf("同步数据面注册表失败：%s", res.Error)
+	}
+	return nil
+}
+
+// dpRevalidate 用该数据面**自己的**域名 / 路径 / UUID 重新验证一批 IP（TLS + WS + 真实隧道）。
+//
+// 返回通过验证的原始行（保留备注与顺序）。端口不是 443 的行不参与验证，也不会被推送。
+func (s *Server) dpRevalidate(ctx context.Context, dp dpreg.DataPlane, lines []string) ([]string, int, error) {
+	var ips []string
+	byIP := map[string][]string{}
+	for _, raw := range lines {
+		pl, ok := parseIPLine(raw)
+		if !ok || pl.Port != 443 {
+			continue
+		}
+		if _, seen := byIP[pl.IP]; !seen {
+			ips = append(ips, pl.IP)
+		}
+		byIP[pl.IP] = append(byIP[pl.IP], pl.Raw)
+	}
+	if len(ips) == 0 {
+		return nil, 0, nil
+	}
+	vctx, cancel := context.WithTimeout(ctx, dpValidateBudget)
+	defer cancel()
+	summary, err := scan.Run(vctx, scan.Options{
+		Host:           dp.Domain,
+		Port:           443,
+		WSPath:         dp.WSPath,
+		ProbePath:      scan.ProbeDefaultPath,
+		ProbeTransport: "ws",
+		Candidates:     ips,
+		SkipSpeed:      true, // 这里只确认「在它的域名下能连通」，不重复测速
+		Top:            len(ips),
+		VerifyPayload:  true,
+		UUID:           dp.UUID,
+		TrojanPassword: dp.TrojanPassword,
+	})
+	if err != nil {
+		return nil, len(ips), err
+	}
+	pass := map[string]bool{}
+	for _, e := range summary.Entries {
+		pass[e.IP] = true
+	}
+	var valid []string
+	for _, ip := range ips {
+		if pass[ip] {
+			valid = append(valid, byIP[ip]...)
+		}
+	}
+	return valid, len(ips), nil
+}
+
+// dpPushOne 向一个数据面推送（验证 + 重试 + 记录）。绝不返回 error —— 失败写进结果。
+func (s *Server) dpPushOne(ctx context.Context, host, token string, dp dpreg.DataPlane, lines []string, mode, reason string) dpPushResult {
+	r := dpPushResult{ID: dp.ID, Name: dp.Name, Domain: dp.Domain}
+	record := func() dpPushResult {
+		_ = s.dpStore().AddRecord(dp.ID, dpreg.PushRecord{
+			At: time.Now().UnixMilli(), Reason: reason, Mode: mode, Status: r.Status, Message: r.Message,
+			Checked: r.Checked, Valid: r.Valid, Added: r.Added, Pool: r.Pool, Attempts: r.Attempts,
+		})
+		return r
+	}
+
+	push := lines
+	if mode != "remove" {
+		valid, checked, err := s.dpRevalidate(ctx, dp, lines)
+		r.Checked = checked
+		if err != nil {
+			r.Status, r.Message = "failed", "重新验证出错："+err.Error()
+			return record()
+		}
+		r.Valid = len(valid)
+		if len(valid) == 0 {
+			r.Status = "skipped"
+			r.Message = fmt.Sprintf("在 %s 下验证了 %d 个 IP，没有一个通过 TLS+WS；未写入，原有池保持不变", dp.Domain, checked)
+			return record()
+		}
+		push = valid
+	}
+
+	delays := []time.Duration{2 * time.Second, 6 * time.Second}
+	var last scan.DPResult
+	for attempt := 1; attempt <= dpPushAttempts; attempt++ {
+		r.Attempts = attempt
+		last = scan.PostResultsDP(ctx, scan.DefaultCallbackURL(host), token, dp.ID, push, mode, 25*time.Second)
+		if last.OK || !last.Retryable || attempt == dpPushAttempts {
+			break
+		}
+		select {
+		case <-ctx.Done():
+			r.Status, r.Message = "failed", "已取消："+ctx.Err().Error()
+			return record()
+		case <-time.After(delays[attempt-1]):
+		}
+	}
+	if !last.OK {
+		r.Status, r.Message = "failed", last.Error
+		return record()
+	}
+	r.Status = "ok"
+	r.Added, r.Pool = last.Added, last.Count
+	if mode == "remove" {
+		r.Message = fmt.Sprintf("已删除 %d 条", last.Removed)
+	} else if r.Valid < r.Checked {
+		r.Message = fmt.Sprintf("验证通过 %d/%d，新增 %d 条", r.Valid, r.Checked, last.Added)
+	} else {
+		r.Message = fmt.Sprintf("新增 %d 条", last.Added)
+	}
+	return record()
+}
+
+// dpPushAll 把 lines 分发到所选数据面（ids 为空 = 全部符合条件的）。
+//
+// auto=true（扫描后自动推送）只推 Enabled && AutoPush 的数据面；
+// auto=false（手动 / 新增后）只看 Enabled。每个数据面串行处理、互不影响。
+func (s *Server) dpPushAll(ctx context.Context, ids []string, lines []string, mode, reason string, auto bool) ([]dpPushResult, error) {
+	if !dpPushLock.TryLock() {
+		return nil, fmt.Errorf("已有一轮推送正在执行，请稍后再试")
+	}
+	defer dpPushLock.Unlock()
+	dpPushing.Lock()
+	dpPushing.on = true
+	dpPushing.Unlock()
+	defer func() {
+		dpPushing.Lock()
+		dpPushing.on = false
+		dpPushing.Unlock()
+		if s.events != nil {
+			s.events.publish("dp-push", map[string]any{"at": schedule.NowMS()})
+		}
+	}()
+
+	want := map[string]bool{}
+	for _, id := range ids {
+		want[id] = true
+	}
+	var targets []dpreg.DataPlane
+	for _, dp := range s.dpStore().List() {
+		if !dp.Enabled || (len(want) > 0 && !want[dp.ID]) {
+			continue
+		}
+		if auto && !dp.AutoPush {
+			continue
+		}
+		targets = append(targets, dp)
+	}
+	if len(targets) == 0 {
+		return nil, nil
+	}
+	if len(lines) == 0 && mode != "remove" {
+		return nil, fmt.Errorf("没有可推送的优选结果")
+	}
+
+	ctx, cancel := context.WithTimeout(ctx, dpPushBudget)
+	defer cancel()
+
+	fail := func(msg string) ([]dpPushResult, error) {
+		out := make([]dpPushResult, 0, len(targets))
+		for _, dp := range targets {
+			r := dpPushResult{ID: dp.ID, Name: dp.Name, Domain: dp.Domain, Status: "failed", Message: msg}
+			_ = s.dpStore().AddRecord(dp.ID, dpreg.PushRecord{At: time.Now().UnixMilli(), Reason: reason, Mode: mode, Status: "failed", Message: msg})
+			out = append(out, r)
+		}
+		return out, nil
+	}
+
+	host, password, err := s.dpControl(ctx)
+	if err != nil {
+		return fail(err.Error())
+	}
+	var tok scan.TokenResult
+	for i := 0; i < 2; i++ {
+		tok = scan.FetchScannerToken(ctx, host, password, 25*time.Second)
+		if tok.OK {
+			break
+		}
+		time.Sleep(2 * time.Second)
+	}
+	if !tok.OK {
+		return fail("获取控制面令牌失败：" + tok.Error)
+	}
+	// 先同步注册表：内核只接受已注册的数据面
+	if reg := scan.PutRegistry(ctx, host, tok.Token, dpRegistryItems(s.dpStore().List()), 20*time.Second); !reg.OK {
+		return fail("同步数据面注册表失败：" + reg.Error)
+	}
+
+	results := make([]dpPushResult, 0, len(targets))
+	for _, dp := range targets {
+		if ctx.Err() != nil {
+			r := dpPushResult{ID: dp.ID, Name: dp.Name, Domain: dp.Domain, Status: "failed", Message: "本轮超时，未处理"}
+			_ = s.dpStore().AddRecord(dp.ID, dpreg.PushRecord{At: time.Now().UnixMilli(), Reason: reason, Mode: mode, Status: "failed", Message: r.Message})
+			results = append(results, r)
+			continue
+		}
+		results = append(results, s.dpPushOne(ctx, host, tok.Token, dp, lines, mode, reason))
+	}
+	return results, nil
+}
+
+// dpLogResults 把一轮推送结果写进运行日志（每个数据面一行）。
+func (s *Server) dpLogResults(title string, results []dpPushResult) {
+	for _, r := range results {
+		level := "ok"
+		switch r.Status {
+		case "failed":
+			level = "warn"
+		case "skipped":
+			level = "info"
+		}
+		s.logLevel(fmt.Sprintf("%s → %s（%s）：%s", title, r.Name, r.Domain, r.Message), level)
+	}
+}
+
+// dpAutoPush 在一次优选成功后自动推送到各数据面。失败只记日志，不影响优选本身。
+func (s *Server) dpAutoPush(lines []string, reason string) {
+	st := s.dpStore()
+	set := st.Settings()
+	if !set.PushAfterScan || len(st.List()) == 0 || len(lines) == 0 {
+		return
+	}
+	if len(lines) > set.Top {
+		lines = lines[:set.Top]
+	}
+	results, err := s.dpPushAll(context.Background(), nil, lines, set.Mode, reason, true)
+	if err != nil {
+		s.logLevel("数据面自动推送未执行："+err.Error(), "warn")
+		return
+	}
+	s.dpLogResults("数据面推送", results)
+}
+
+// dpSourceLines 取「当前最新的优选结果」：定时优选 IP 池顶部的前 n 条。
+func (s *Server) dpSourceLines(n int) []string {
+	pool := s.scheduleStore().Pool()
+	schedule.SortPool(pool)
+	if n > 0 && len(pool) > n {
+		pool = pool[:n]
+	}
+	return schedule.CopyLines(pool)
+}
diff --git a/packages/desktop/internal/server/dp_routes.go b/packages/desktop/internal/server/dp_routes.go
new file mode 100644
index 0000000..e5eaf98
--- /dev/null
+++ b/packages/desktop/internal/server/dp_routes.go
@@ -0,0 +1,392 @@
+package server
+
+// 1:N 多数据面管理接口。
+//
+//	GET  /api/dp                 数据面清单 + 全局设置 + 账号列表 + 各数据面在控制面的池条数
+//	POST /api/dp/save            新增 / 更新一个数据面（新增且开启「新增后推送」时自动推送）
+//	POST /api/dp/delete          删除一个数据面（同步到控制面，独立池一并清掉）
+//	POST /api/dp/sync-deploy     从该数据面所属账号的部署清单读取域名 / UUID / 路径 / 内核版本
+//	POST /api/dp/push            手动推送（异步；结果见各数据面的推送记录）
+//	POST /api/dp/ips/remove      从某个数据面的池里删除指定 IP
+//	POST /api/dp/settings        保存全局推送设置
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/xmwengxing/cfpilot/packages/desktop/internal/deploy"
+	"github.com/xmwengxing/cfpilot/packages/desktop/internal/dpreg"
+	"github.com/xmwengxing/cfpilot/packages/desktop/internal/scan"
+)
+
+func (s *Server) registerDPRoutes(mux *http.ServeMux) {
+	mux.HandleFunc("/api/dp", s.guard(s.handleDPList))
+	mux.HandleFunc("/api/dp/save", s.guard(s.handleDPSave))
+	mux.HandleFunc("/api/dp/delete", s.guard(s.handleDPDelete))
+	mux.HandleFunc("/api/dp/sync-deploy", s.guard(s.handleDPSyncDeploy))
+	mux.HandleFunc("/api/dp/push", s.guard(s.handleDPPush))
+	mux.HandleFunc("/api/dp/ips/remove", s.guard(s.handleDPRemoveIPs))
+	mux.HandleFunc("/api/dp/settings", s.guard(s.handleDPSettings))
+}
+
+func dpDecode(w http.ResponseWriter, r *http.Request, v any) bool {
+	if r.Method != http.MethodPost {
+		writeJSON(w, http.StatusMethodNotAllowed, map[string]any{"error": "仅支持 POST"})
+		return false
+	}
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 1<<20)).Decode(v); err != nil {
+		writeJSON(w, http.StatusBadRequest, map[string]any{"error": "请求体解析失败"})
+		return false
+	}
+	return true
+}
+
+// handleDPList 返回数据面清单。
+func (s *Server) handleDPList(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		writeJSON(w, http.StatusMethodNotAllowed, map[string]any{"error": "仅支持 GET"})
+		return
+	}
+	st := s.dpStore()
+	type profileRow struct {
+		ID          string `json:"id"`
+		Name        string `json:"name"`
+		AccountName string `json:"accountName"`
+		HasToken    bool   `json:"hasToken"`
+		HasKV       bool   `json:"hasKv"`
+	}
+	var profiles []profileRow
+	if list, err := s.store.List(); err == nil {
+		for _, p := range list {
+			profiles = append(profiles, profileRow{
+				ID: p.ID, Name: p.Name, AccountName: p.AccountName,
+				HasToken: strings.TrimSpace(p.CfToken) != "", HasKV: strings.TrimSpace(p.KVNamespaceID) != "",
+			})
+		}
+	}
+	pools := map[string]int{}
+	poolErr := ""
+	if r.URL.Query().Get("pools") == "1" && len(st.List()) > 0 {
+		ctx, cancel := context.WithTimeout(r.Context(), 30*time.Second)
+		defer cancel()
+		if host, pw, err := s.dpControl(ctx); err != nil {
+			poolErr = err.Error()
+		} else if tok := scan.FetchScannerToken(ctx, host, pw, 20*time.Second); !tok.OK {
+			poolErr = tok.Error
+		} else if m, err := scan.PoolCounts(ctx, host, tok.Token, 15*time.Second); err != nil {
+			poolErr = err.Error()
+		} else {
+			pools = m
+		}
+	}
+	dpPushing.Lock()
+	pushing := dpPushing.on
+	dpPushing.Unlock()
+	writeJSON(w, http.StatusOK, map[string]any{
+		"ok": true, "planes": st.List(), "settings": st.Settings(), "profiles": profiles,
+		"pools": pools, "poolError": poolErr, "pushing": pushing,
+		"fixedDomains": st.FixedRecords(),
+	})
+}
+
+type dpSaveReq struct {
+	ID             string `json:"id"`
+	Name           string `json:"name"`
+	ProfileID      string `json:"profileId"`
+	WorkerName     string `json:"workerName"`
+	Domain         string `json:"domain"`
+	UUID           string `json:"uuid"`
+	WSPath         string `json:"wsPath"`
+	TrojanPassword string `json:"trojanPassword"`
+	TrojanPath     string `json:"trojanPath"`
+	XHTTPPath      string `json:"xhttpPath"`
+	Enabled        *bool  `json:"enabled"`
+	AutoPush       *bool  `json:"autoPush"`
+	// FromDeploy 为 true 时先从账号的部署清单读取域名 / UUID / 路径（留空的字段才会被覆盖）。
+	FromDeploy bool `json:"fromDeploy"`
+}
+
+// dpReadDeploy 读该账号的部署清单 + KV CONFIG，填充 dp 里还没填的字段。
+func (s *Server) dpReadDeploy(ctx context.Context, dp *dpreg.DataPlane, overwrite bool) error {
+	profile, err := s.store.Get(dp.ProfileID)
+	if err != nil || profile == nil {
+		return fmt.Errorf("所属账号不存在")
+	}
+	if strings.TrimSpace(profile.CfToken) == "" || strings.TrimSpace(profile.AccountID) == "" || strings.TrimSpace(profile.KVNamespaceID) == "" {
+		return fmt.Errorf("该账号缺少 API Token / Account ID / KV，请先在凭据页检测账号并选择 KV")
+	}
+	rctx, cancel := context.WithTimeout(ctx, 25*time.Second)
+	defer cancel()
+	client := s.newCFClient(profile.CfToken)
+	raw, ok := client.GetKVValue(rctx, profile.AccountID, profile.KVNamespaceID, deploy.ManifestKey)
+	if !ok || strings.TrimSpace(raw) == "" {
+		return fmt.Errorf("该账号还没有部署清单，请先在部署页完成一次部署")
+	}
+	var m deploy.Manifest
+	if err := json.Unmarshal([]byte(raw), &m); err != nil {
+		return fmt.Errorf("部署清单格式损坏")
+	}
+	set := func(dst *string, v string) {
+		v = strings.TrimSpace(v)
+		if v != "" && (overwrite || strings.TrimSpace(*dst) == "") {
+			*dst = v
+		}
+	}
+	domain := strings.TrimSpace(m.DataCustomDomain)
+	if domain == "" {
+		domain = normalizePagesHost(m.DataSubdomain)
+	}
+	set(&dp.Domain, domain)
+	set(&dp.UUID, m.Credentials.UUID)
+	set(&dp.TrojanPassword, m.Credentials.TrojanPassword)
+	set(&dp.WSPath, m.Credentials.WSPath)
+	set(&dp.WorkerName, m.DataProject)
+	dp.KernelVersion = strings.TrimSpace(m.KernelVersion)
+	dp.LastDeployAt = strings.TrimSpace(m.At)
+	// KV 里的 CONFIG 才是现行配置（清单里的路径只是部署当时的快照）
+	if rawCfg, ok := client.GetKVValue(rctx, profile.AccountID, profile.KVNamespaceID, deploy.ConfigKey); ok && rawCfg != "" {
+		var cfg struct {
+			WsPath         string `json:"wsPath"`
+			XhttpPath      string `json:"xhttpPath"`
+			TrojanPath     string `json:"trojanPath"`
+			TrojanPassword string `json:"trojanPassword"`
+			UUID           string `json:"uuid"`
+		}
+		if json.Unmarshal([]byte(rawCfg), &cfg) == nil {
+			set(&dp.WSPath, cfg.WsPath)
+			set(&dp.XHTTPPath, cfg.XhttpPath)
+			set(&dp.TrojanPath, cfg.TrojanPath)
+			set(&dp.TrojanPassword, cfg.TrojanPassword)
+			set(&dp.UUID, cfg.UUID)
+		}
+	}
+	return nil
+}
+
+func (s *Server) handleDPSave(w http.ResponseWriter, r *http.Request) {
+	var req dpSaveReq
+	if !dpDecode(w, r, &req) {
+		return
+	}
+	st := s.dpStore()
+	isNew := strings.TrimSpace(req.ID) == ""
+	dp := dpreg.DataPlane{Enabled: true, AutoPush: true}
+	if !isNew {
+		cur, ok := st.Get(req.ID)
+		if !ok {
+			writeJSON(w, http.StatusOK, map[string]any{"ok": false, "error": "数据面不存在"})
+			return
+		}
+		dp = cur
+	} else {
+		dp.ID = dpreg.NewID()
+	}
+	if req.ProfileID != "" {
+		dp.ProfileID = req.ProfileID
+	}
+	if strings.TrimSpace(req.Name) != "" {
+		dp.Name = req.Name
+	}
+	dp.WorkerName = firstNonEmpty(req.WorkerName, dp.WorkerName)
+	dp.Domain = firstNonEmpty(req.Domain, dp.Domain)
+	dp.UUID = firstNonEmpty(req.UUID, dp.UUID)
+	dp.WSPath = firstNonEmpty(req.WSPath, dp.WSPath)
+	dp.TrojanPassword = firstNonEmpty(req.TrojanPassword, dp.TrojanPassword)
+	dp.TrojanPath = firstNonEmpty(req.TrojanPath, dp.TrojanPath)
+	dp.XHTTPPath = firstNonEmpty(req.XHTTPPath, dp.XHTTPPath)
+	if req.Enabled != nil {
+		dp.Enabled = *req.Enabled
+	}
+	if req.AutoPush != nil {
+		dp.AutoPush = *req.AutoPush
+	}
+	if p, err := s.store.Get(dp.ProfileID); err != nil || p == nil {
+		writeJSON(w, http.StatusOK, map[string]any{"ok": false, "error": "请选择该数据面所属的账号（账号需先在凭据页添加）"})
+		return
+	}
+	if req.FromDeploy {
+		if err := s.dpReadDeploy(r.Context(), &dp, false); err != nil {
+			writeJSON(w, http.StatusOK, map[string]any{"ok": false, "error": "从部署读取失败：" + err.Error()})
+			return
+		}
+	}
+	saved, err := st.Upsert(dp)
+	if err != nil {
+		writeJSON(w, http.StatusOK, map[string]any{"ok": false, "error": err.Error()})
+		return
+	}
+
+	// 同步到控制面：订阅聚合立刻生效（池为空时先借用全局池，新数据面马上有节点）。
+	warn := ""
+	sctx, cancel := context.WithTimeout(r.Context(), 60*time.Second)
+	defer cancel()
+	if err := s.dpSyncRegistry(sctx); err != nil {
+		warn = "已保存到本地，但同步控制面失败（下次推送时会重试）：" + err.Error()
+	}
+
+	started := false
+	if isNew && warn == "" && st.Settings().PushAfterAdd && saved.Enabled {
+		if lines := s.dpSourceLines(st.Settings().Top); len(lines) > 0 {
+			started = true
+			id := saved.ID
+			go func() {
+				res, err := s.dpPushAll(context.Background(), []string{id}, lines, st.Settings().Mode, "add", false)
+				if err != nil {
+					s.logLevel("新增数据面后推送未执行："+err.Error(), "warn")
+					return
+				}
+				s.dpLogResults("新增数据面推送", res)
+			}()
+		}
+	}
+	writeJSON(w, http.StatusOK, map[string]any{"ok": true, "plane": saved, "warning": warn, "pushStarted": started})
+}
+
+func (s *Server) handleDPDelete(w http.ResponseWriter, r *http.Request) {
+	var req struct {
+		ID string `json:"id"`
+	}
+	if !dpDecode(w, r, &req) {
+		return
+	}
+	ok, err := s.dpStore().Delete(req.ID)
+	if err != nil {
+		writeJSON(w, http.StatusOK, map[string]any{"ok": false, "error": err.Error()})
+		return
+	}
+	if !ok {
+		writeJSON(w, http.StatusOK, map[string]any{"ok": false, "error": "数据面不存在"})
+		return
+	}
+	warn := ""
+	ctx, cancel := context.WithTimeout(r.Context(), 60*time.Second)
+	defer cancel()
+	if err := s.dpSyncRegistry(ctx); err != nil {
+		warn = "本地已删除，但同步控制面失败（控制面上的订阅暂时还含它，下次同步会清掉）：" + err.Error()
+	}
+	writeJSON(w, http.StatusOK, map[string]any{"ok": true, "warning": warn})
+}
+
+func (s *Server) handleDPSyncDeploy(w http.ResponseWriter, r *http.Request) {
+	var req struct {
+		ID string `json:"id"`
+	}
+	if !dpDecode(w, r, &req) {
+		return
+	}
+	dp, ok := s.dpStore().Get(req.ID)
+	if !ok {
+		writeJSON(w, http.StatusOK, map[string]any{"ok": false, "error": "数据面不存在"})
+		return
+	}
+	if err := s.dpReadDeploy(r.Context(), &dp, true); err != nil {
+		writeJSON(w, http.StatusOK, map[string]any{"ok": false, "error": err.Error()})
+		return
+	}
+	saved, err := s.dpStore().Upsert(dp)
+	if err != nil {
+		writeJSON(w, http.StatusOK, map[string]any{"ok": false, "error": err.Error()})
+		return
+	}
+	warn := ""
+	ctx, cancel := context.WithTimeout(r.Context(), 60*time.Second)
+	defer cancel()
+	if err := s.dpSyncRegistry(ctx); err != nil {
+		warn = "已更新本地，但同步控制面失败：" + err.Error()
+	}
+	writeJSON(w, http.StatusOK, map[string]any{"ok": true, "plane": saved, "warning": warn})
+}
+
+func (s *Server) handleDPPush(w http.ResponseWriter, r *http.Request) {
+	var req struct {
+		IDs   []string `json:"ids"`
+		Mode  string   `json:"mode"`
+		Lines []string `json:"lines"`
+	}
+	if !dpDecode(w, r, &req) {
+		return
+	}
+	st := s.dpStore()
+	set := st.Settings()
+	mode := req.Mode
+	if mode != "append" && mode != "replace" {
+		mode = set.Mode
+	}
+	lines := req.Lines
+	if len(lines) == 0 {
+		lines = s.dpSourceLines(set.Top)
+	}
+	if len(lines) == 0 {
+		writeJSON(w, http.StatusOK, map[string]any{"ok": false, "error": "还没有可推送的优选结果：先跑一次优选（或在输入框里粘贴 IP 行）"})
+		return
+	}
+	if len(lines) > 200 {
+		lines = lines[:200]
+	}
+	if !dpPushLock.TryLock() {
+		writeJSON(w, http.StatusOK, map[string]any{"ok": false, "error": "已有一轮推送正在执行，请稍后再试"})
+		return
+	}
+	dpPushLock.Unlock()
+	go func() {
+		res, err := s.dpPushAll(context.Background(), req.IDs, lines, mode, "manual", false)
+		if err != nil {
+			s.logLevel("手动推送未执行："+err.Error(), "warn")
+			return
+		}
+		s.dpLogResults("手动推送", res)
+	}()
+	writeJSON(w, http.StatusOK, map[string]any{"ok": true, "started": true, "mode": mode, "count": len(lines)})
+}
+
+func (s *Server) handleDPRemoveIPs(w http.ResponseWriter, r *http.Request) {
+	var req struct {
+		ID  string   `json:"id"`
+		IPs []string `json:"ips"`
+	}
+	if !dpDecode(w, r, &req) {
+		return
+	}
+	dp, ok := s.dpStore().Get(req.ID)
+	if !ok {
+		writeJSON(w, http.StatusOK, map[string]any{"ok": false, "error": "数据面不存在"})
+		return
+	}
+	if len(req.IPs) == 0 {
+		writeJSON(w, http.StatusOK, map[string]any{"ok": false, "error": "没有选中任何 IP"})
+		return
+	}
+	res, err := s.dpPushAll(r.Context(), []string{dp.ID}, req.IPs, "remove", "manual", false)
+	if err != nil {
+		writeJSON(w, http.StatusOK, map[string]any{"ok": false, "error": err.Error()})
+		return
+	}
+	if len(res) == 0 {
+		writeJSON(w, http.StatusOK, map[string]any{"ok": false, "error": "该数据面已停用"})
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]any{"ok": res[0].Status == "ok", "result": res[0], "error": errIfFailed(res[0])})
+}
+
+func errIfFailed(r dpPushResult) string {
+	if r.Status == "failed" {
+		return r.Message
+	}
+	return ""
+}
+
+func (s *Server) handleDPSettings(w http.ResponseWriter, r *http.Request) {
+	var req dpreg.Settings
+	if !dpDecode(w, r, &req) {
+		return
+	}
+	if err := s.dpStore().SetSettings(req); err != nil {
+		writeJSON(w, http.StatusOK, map[string]any{"ok": false, "error": err.Error()})
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]any{"ok": true, "settings": s.dpStore().Settings()})
+}
diff --git a/packages/desktop/internal/server/fixed_domains.go b/packages/desktop/internal/server/fixed_domains.go
new file mode 100644
index 0000000..6bc7490
--- /dev/null
+++ b/packages/desktop/internal/server/fixed_domains.go
@@ -0,0 +1,136 @@
+package server
+
+// 固定默认优选域名的「测速并记录」。
+//
+// ## 规则（用户定的）
+//
+//   - 这些域名参与每次优选的测速，**只作记录**；
+//   - 测速结果**不会**让它们被剔除：它们永远在自定义订阅优选池里
+//     （控制面内核保证，见 worker-core 的 FIXED_PREFERRED_DOMAINS）；
+//   - 记录失败（解析不了 / 测速失败）只写日志，不影响优选本身。
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"strings"
+	"time"
+
+	"github.com/xmwengxing/cfpilot/packages/desktop/internal/dpreg"
+	"github.com/xmwengxing/cfpilot/packages/desktop/internal/scan"
+)
+
+// lookupIPs 可在测试里替换。
+var lookupIPs = func(ctx context.Context, host string) ([]net.IPAddr, error) {
+	return net.DefaultResolver.LookupIPAddr(ctx, host)
+}
+
+const fixedRecordBudget = 3 * time.Minute
+
+// resolveFixedDomain 解析一个固定域名：优先取最多 2 个 IPv4；没有 IPv4 才取 1 个 IPv6。
+func resolveFixedDomain(ctx context.Context, domain string) ([]string, error) {
+	rctx, cancel := context.WithTimeout(ctx, 6*time.Second)
+	defer cancel()
+	addrs, err := lookupIPs(rctx, domain)
+	if err != nil {
+		return nil, err
+	}
+	var v4, v6 []string
+	for _, a := range addrs {
+		if a.IP.To4() != nil {
+			if len(v4) < 2 {
+				v4 = append(v4, a.IP.String())
+			}
+		} else if len(v6) < 1 {
+			v6 = append(v6, a.IP.String())
+		}
+	}
+	if len(v4) > 0 {
+		return v4, nil
+	}
+	return v6, nil
+}
+
+// recordFixedDomains 对固定域名解析 → 测速 → 记录。绝不返回 error，也不影响调用方。
+//
+// host / wsPath / uuid / trojan 是本轮优选用的那一份数据面参数，保证口径一致。
+func (s *Server) recordFixedDomains(ctx context.Context, host, wsPath, uuid, trojanPassword string) {
+	ctx, cancel := context.WithTimeout(ctx, fixedRecordBudget)
+	defer cancel()
+
+	byIP := map[string][]string{}
+	var cands []string
+	recs := map[string]dpreg.FixedRecord{}
+	now := time.Now().UnixMilli()
+	for _, d := range dpreg.FixedDomains {
+		ips, err := resolveFixedDomain(ctx, d)
+		if err != nil || len(ips) == 0 {
+			note := "解析失败"
+			if err != nil {
+				note += "：" + err.Error()
+			}
+			recs[d] = dpreg.FixedRecord{Domain: d, Note: note, At: now}
+			continue
+		}
+		recs[d] = dpreg.FixedRecord{Domain: d, IPs: ips, Note: "测速中", At: now}
+		for _, ip := range ips {
+			if _, seen := byIP[ip]; !seen {
+				cands = append(cands, ip)
+			}
+			byIP[ip] = append(byIP[ip], d)
+		}
+	}
+
+	var summary *scan.Summary
+	if len(cands) > 0 {
+		var err error
+		summary, err = scan.Run(ctx, scan.Options{
+			Host:            host,
+			Port:            443,
+			WSPath:          wsPath,
+			ProbePath:       scan.ProbeDefaultPath,
+			Candidates:      cands,
+			Top:             len(cands),
+			SpeedDurationMs: 3000,
+			VerifyPayload:   true,
+			UUID:            strings.TrimSpace(uuid),
+			TrojanPassword:  strings.TrimSpace(trojanPassword),
+		})
+		if err != nil {
+			s.logLevel("固定域名测速出错（仅记录，不影响优选）："+err.Error(), "warn")
+			summary = nil
+		}
+	}
+
+	best := map[string]scan.Entry{}
+	if summary != nil {
+		for _, e := range summary.Entries {
+			for _, d := range byIP[e.IP] {
+				if cur, ok := best[d]; !ok || e.Speed > cur.Speed {
+					best[d] = e
+				}
+			}
+		}
+	}
+	okCount := 0
+	for _, d := range dpreg.FixedDomains {
+		r := recs[d]
+		if len(r.IPs) == 0 {
+			continue
+		}
+		if e, ok := best[d]; ok {
+			r.OK, r.LatencyMs, r.SpeedMBps, r.Colo, r.Note = true, e.Latency, e.Speed, e.Colo, "测速通过（仅记录）"
+			okCount++
+		} else {
+			r.Note = "本轮测速未通过（仅记录；仍保留在订阅里）"
+		}
+		recs[d] = r
+	}
+	if err := s.dpStore().SetFixed(recs); err != nil {
+		s.logLevel("固定域名记录写入失败："+err.Error(), "warn")
+	}
+	if summary != nil && len(summary.Entries) > 0 {
+		s.saveScanHistory("fixed-domains", host, wsPath, scan.ProbeDefaultPath, false, summary.Entries, "", historyStats(summary), false, 0)
+	}
+	s.logLevel(fmt.Sprintf("固定优选域名已测速记录：%d/%d 通过（仅记录，9 个域名始终保留在自定义订阅优选池）", okCount, len(dpreg.FixedDomains)), "info")
+}
