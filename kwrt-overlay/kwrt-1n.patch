+	}
+	if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+		return true
+	}
+	var ne net.Error
+	if errors.As(err, &ne) && ne.Timeout() {
+		return true
+	}
+	if isConnectStageErr(err) {
+		return true
+	}
+	msg := strings.ToLower(err.Error())
+	for _, k := range []string{
+		"eof",
+		"timeout",
+		"connection reset",
+		"forcibly closed",
+		"broken pipe",
+		"wsarecv",
+		"wsasend",
+	} {
