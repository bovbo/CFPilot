+export async function loadDpRegistry(store: Store): Promise<DataPlaneRecord[]> {
+  try {
+    const raw = await store.get(DP_REGISTRY_KEY)
+    if (!raw) return []
+    const arr = JSON.parse(raw) as unknown
+    if (!Array.isArray(arr)) return []
