+package cfapi
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// 前两次连接直接被掐断（模拟 EOF / 链路抖动），第三次正常：GET 应自动重试成功。
+func TestGetRetriesTransientEOF(t *testing.T) {
+	var n int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if atomic.AddInt32(&n, 1) <= 2 {
+			hj, _ := w.(http.Hijacker)
+			conn, _, _ := hj.Hijack()
+			_ = conn.Close()
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"success":true,"errors":[],"result":{"ok":1}}`))
+	}))
+	defer srv.Close()
+
+	c := New(Options{Token: "t", APIBase: srv.URL, TimeoutMs: 5000})
+	var out struct{ Ok int }
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	if err := c.doJSON(ctx, http.MethodGet, "/x", nil, &out); err != nil {
+		t.Fatalf("应重试成功，却失败：%v", err)
+	}
+	if out.Ok != 1 || atomic.LoadInt32(&n) != 3 {
+		t.Fatalf("out=%+v 请求次数=%d，期望 ok=1、3 次", out, n)
+	}
+}
+
+// 业务错误（HTTP 400）不能重试。
+func TestBusinessErrorNotRetried(t *testing.T) {
+	var n int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		atomic.AddInt32(&n, 1)
+		w.WriteHeader(400)
+		_, _ = w.Write([]byte(`{"success":false,"errors":[{"code":1000,"message":"bad"}]}`))
+	}))
+	defer srv.Close()
+
+	c := New(Options{Token: "t", APIBase: srv.URL})
+	if err := c.doJSON(context.Background(), http.MethodGet, "/x", nil, nil); err == nil {
+		t.Fatal("期望返回错误")
+	}
+	if atomic.LoadInt32(&n) != 1 {
+		t.Fatalf("业务错误被重试了 %d 次", n)
+	}
+}
+
+// POST 请求发出后连接被掐断：可能已被服务端处理，不能重试（避免重复提交）。
+func TestPostNotRetriedAfterSend(t *testing.T) {
+	var n int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		atomic.AddInt32(&n, 1)
+		hj, _ := w.(http.Hijacker)
+		conn, _, _ := hj.Hijack()
+		_ = conn.Close()
+	}))
+	defer srv.Close()
+
+	c := New(Options{Token: "t", APIBase: srv.URL})
+	if err := c.doJSON(context.Background(), http.MethodPost, "/x", map[string]string{"a": "b"}, nil); err == nil {
+		t.Fatal("期望返回错误")
+	}
+	if atomic.LoadInt32(&n) != 1 {
+		t.Fatalf("POST 发出后失败被重试了 %d 次", n)
+	}
+}
diff --git a/packages/desktop/internal/dpreg/dpreg.go b/packages/desktop/internal/dpreg/dpreg.go
new file mode 100644
index 0000000..29cdc5e
--- /dev/null
+++ b/packages/desktop/internal/dpreg/dpreg.go
@@ -0,0 +1,380 @@
+// Package dpreg 是 1:N 多数据面的本地注册表。
+//
+// ## 设计要点
+//
+// 每个数据面是**独立 Cloudflare 账号**下的一个 Worker，字段互不混用：
+// 凭据（Account ID / API Token / KV）仍由 store.Profile 保管（secrets.json，0600），
+// 这里只用 ProfileID 引用，**不复制任何密钥**，也不会合并成一份全局 CONFIG。
+//
+// 注册表只描述「这个数据面是谁、域名/UUID/路径是什么、最近一次推送结果」。
+// 其中渲染订阅需要的那部分（域名 / UUID / 路径）会同步到控制面，
+// Account ID / Token / KV 永远不会离开本机。
+package dpreg
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+)
+
+const (
+	// Filename 是注册表文件名（与 scheduled-tasks.json 同目录）。
+	Filename = "dataplanes.json"
+	Schema   = 1
+	// MaxPlanes 与内核的 DP_MAX_COUNT 保持一致。
+	MaxPlanes = 16
+	// MaxLog 是每个数据面保留的推送记录条数。
+	MaxLog = 20
+)
+
+var idRe = regexp.MustCompile(`^[a-z0-9][a-z0-9-]{0,31}$`)
+
+// PushRecord 是一次推送的结果记录（每个数据面各自独立）。
+type PushRecord struct {
+	At       int64  `json:"at"`
+	Reason   string `json:"reason"`   // scan / schedule / add / manual
+	Mode     string `json:"mode"`     // append / replace / remove
+	Status   string `json:"status"`   // ok / failed / skipped
+	Message  string `json:"message"`  // 失败原因或说明
+	Checked  int    `json:"checked"`  // 参与重新验证的 IP 数
+	Valid    int    `json:"valid"`    // 通过验证的 IP 数
+	Added    int    `json:"added"`    // 实际新增（去重后）
+	Pool     int    `json:"pool"`     // 推送后该数据面池内条数
+	Attempts int    `json:"attempts"` // 尝试次数（含重试）
+}
+
+// DataPlane 是一个数据面。
+type DataPlane struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+	// ProfileID 引用该数据面所属账号（store.Profile）。每个数据面各用各的账号。
+	ProfileID  string `json:"profileId"`
+	WorkerName string `json:"workerName"`
+	Domain     string `json:"domain"`
+
+	UUID           string `json:"uuid"`
+	WSPath         string `json:"wsPath"`
+	TrojanPassword string `json:"trojanPassword"`
+	TrojanPath     string `json:"trojanPath"`
+	XHTTPPath      string `json:"xhttpPath"`
+
+	Enabled bool `json:"enabled"`
+	// AutoPush 为 false 时，扫描后的自动推送会跳过它（仍可手动推送）。
+	AutoPush bool `json:"autoPush"`
+
+	KernelVersion string `json:"kernelVersion"`
+	LastDeployAt  string `json:"lastDeployAt"`
+
+	CreatedAt int64        `json:"createdAt"`
+	UpdatedAt int64        `json:"updatedAt"`
+	Log       []PushRecord `json:"log"`
+}
+
+// Settings 是 1:N 全局推送设置。
+type Settings struct {
+	// ControlProfileID 指定控制面所在账号；空 = 当前活跃账号。
+	ControlProfileID string `json:"controlProfileId"`
+	// PushAfterAdd：新增数据面后立即推送当前优选结果（默认开）。
+	PushAfterAdd bool `json:"pushAfterAdd"`
+	// PushAfterScan：每次优选成功后自动推送到各数据面（默认开）。
+	PushAfterScan bool `json:"pushAfterScan"`
+	// Mode：自动推送的写入方式，append（默认）/ replace。
+	Mode string `json:"mode"`
+	// Top：每个数据面每次推送的 IP 数上限（默认 15）。
+	Top int `json:"top"`
+}
+
+// FixedDomains 是固定默认优选域名。
+//
+// 必须与内核 packages/worker-core/src/data/pools.ts 的 FIXED_PREFERRED_DOMAINS 一致
+// （dpreg_test.go 里有对照测试，改一边忘改另一边会直接失败）。
+//
+// 规则：它们**永远**在自定义订阅优选池里（由控制面内核保证）；这里只负责「测速并记录」，
+// 测速结果不会让任何一个域名被剔除。
+var FixedDomains = []string{
+	"sb.mao99.eu.org",
+	"sb6.mao99.eu.org",
+	"sb4.mao99.eu.org",
+	"vvv.me88.cloudns.org",
+	"vvv4.me88.cloudns.org",
+	"vvv6.me88.cloudns.org",
+	"o0o.maoii.eu.org",
+	"o0o4.maoii.eu.org",
+	"o0o6.maoii.eu.org",
+}
+
+// FixedRecord 是某个固定域名最近一次测速记录（仅作记录）。
+type FixedRecord struct {
+	Domain    string   `json:"domain"`
+	IPs       []string `json:"ips"`
+	OK        bool     `json:"ok"`
+	LatencyMs int64    `json:"latencyMs"`
+	SpeedMBps float64  `json:"speedMBps"`
+	Colo      string   `json:"colo"`
+	Note      string   `json:"note"`
+	At        int64    `json:"at"`
+}
+
+type fileData struct {
+	Schema    int                    `json:"schema"`
+	UpdatedAt int64                  `json:"updatedAt"`
+	Settings  Settings               `json:"settings"`
+	Planes    []DataPlane            `json:"planes"`
+	Fixed     map[string]FixedRecord `json:"fixed,omitempty"`
+}
+
+// DefaultSettings 返回默认设置。
+func DefaultSettings() Settings {
+	return Settings{PushAfterAdd: true, PushAfterScan: true, Mode: "append", Top: 15}
+}
+
+func (s *Settings) normalize() {
+	if s.Mode != "replace" {
+		s.Mode = "append"
+	}
+	if s.Top <= 0 || s.Top > 200 {
+		s.Top = 15
+	}
+}
+
+// Store 是注册表存储（内存缓存 + 变更即原子落盘）。
+type Store struct {
+	mu   sync.Mutex
+	dir  string
+	data fileData
+	ok   bool
+}
+
+// New 创建存储。
+func New(dir string) *Store { return &Store{dir: dir} }
+
+func (s *Store) path() string { return filepath.Join(s.dir, Filename) }
+
+func (s *Store) loadLocked() {
+	if s.ok {
+		return
+	}
+	s.ok = true
+	s.data = fileData{Schema: Schema, Settings: DefaultSettings()}
+	raw, err := os.ReadFile(s.path())
+	if err != nil {
+		return
+	}
+	var f fileData
+	if json.Unmarshal(raw, &f) != nil {
+		return
+	}
+	f.Settings.normalize()
+	s.data = f
+}
+
+func (s *Store) saveLocked() error {
+	s.data.Schema = Schema
+	s.data.UpdatedAt = time.Now().UnixMilli()
+	raw, err := json.MarshalIndent(s.data, "", "  ")
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(s.dir, 0o700); err != nil {
+		return err
+	}
+	tmp := s.path() + ".tmp"
+	if err := os.WriteFile(tmp, raw, 0o600); err != nil {
+		return err
+	}
+	return os.Rename(tmp, s.path())
+}
+
+// NewID 生成数据面 id（`dp-` + 6 位十六进制，满足内核的 id 规则）。
+func NewID() string {
+	b := make([]byte, 3)
+	_, _ = rand.Read(b)
+	return "dp-" + hex.EncodeToString(b)
+}
+
+// ValidID 判断 id 是否合法。
+func ValidID(id string) bool { return idRe.MatchString(id) }
+
+// List 返回全部数据面（副本）。
+func (s *Store) List() []DataPlane {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.loadLocked()
+	out := make([]DataPlane, len(s.data.Planes))
+	copy(out, s.data.Planes)
+	return out
+}
+
+// Get 按 id 取一个数据面。
+func (s *Store) Get(id string) (DataPlane, bool) {
+	for _, dp := range s.List() {
+		if dp.ID == id {
+			return dp, true
+		}
+	}
+	return DataPlane{}, false
+}
+
+// Settings 返回全局设置。
+func (s *Store) Settings() Settings {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.loadLocked()
+	return s.data.Settings
+}
+
+// SetSettings 保存全局设置。
+func (s *Store) SetSettings(v Settings) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.loadLocked()
+	v.normalize()
+	s.data.Settings = v
+	return s.saveLocked()
+}
+
+func cleanPath(p, def string) string {
+	p = strings.TrimSpace(p)
+	if p == "" {
+		return def
+	}
+	if !strings.HasPrefix(p, "/") {
+		p = "/" + p
+	}
+	return p
+}
+
+// NormalizeDomain 去掉协议 / 路径并转小写。
+func NormalizeDomain(d string) string {
+	d = strings.ToLower(strings.TrimSpace(d))
+	d = strings.TrimPrefix(strings.TrimPrefix(d, "https://"), "http://")
+	if i := strings.IndexAny(d, "/?#"); i >= 0 {
+		d = d[:i]
+	}
+	return d
+}
+
+var domainRe = regexp.MustCompile(`^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$`)
+
+// Validate 校验一个数据面记录。
+func Validate(dp *DataPlane) error {
+	dp.Domain = NormalizeDomain(dp.Domain)
+	dp.Name = strings.TrimSpace(dp.Name)
+	if dp.Name == "" {
+		dp.Name = dp.ID
+	}
+	if r := []rune(dp.Name); len(r) > 24 {
+		dp.Name = string(r[:24])
+	}
+	if !ValidID(dp.ID) {
+		return fmt.Errorf("数据面 ID 不合法（只能小写字母/数字/连字符）")
+	}
+	if strings.TrimSpace(dp.ProfileID) == "" {
+		return fmt.Errorf("请选择该数据面所属的账号")
+	}
+	if dp.Domain == "" || !domainRe.MatchString(dp.Domain) {
+		return fmt.Errorf("数据面域名不合法")
+	}
+	if strings.TrimSpace(dp.UUID) == "" {
+		return fmt.Errorf("缺少 UUID（可点「从部署读取」自动填入）")
+	}
+	dp.WSPath = cleanPath(dp.WSPath, "/")
+	dp.TrojanPath = cleanPath(dp.TrojanPath, "/trojan")
+	dp.XHTTPPath = cleanPath(dp.XHTTPPath, "/xhttp")
+	return nil
+}
+
+// Upsert 新增或更新一个数据面。更新时保留推送记录与创建时间。
+func (s *Store) Upsert(dp DataPlane) (DataPlane, error) {
+	if err := Validate(&dp); err != nil {
+		return dp, err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.loadLocked()
+	now := time.Now().UnixMilli()
+	for i, cur := range s.data.Planes {
+		if cur.ID == dp.ID {
+			dp.CreatedAt = cur.CreatedAt
+			dp.Log = cur.Log
+			dp.UpdatedAt = now
+			s.data.Planes[i] = dp
+			return dp, s.saveLocked()
+		}
+		// 同一账号 + 同一域名只能登记一次，避免重复推送、订阅里出现重复节点
+		if cur.ProfileID == dp.ProfileID && cur.Domain == dp.Domain {
+			return dp, fmt.Errorf("该账号下已登记过域名 %s（%s）", dp.Domain, cur.Name)
+		}
+	}
+	if len(s.data.Planes) >= MaxPlanes {
+		return dp, fmt.Errorf("数据面数量已达上限 %d", MaxPlanes)
+	}
+	dp.CreatedAt, dp.UpdatedAt = now, now
+	s.data.Planes = append(s.data.Planes, dp)
+	return dp, s.saveLocked()
+}
+
+// Delete 删除一个数据面。
+func (s *Store) Delete(id string) (bool, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.loadLocked()
+	for i, cur := range s.data.Planes {
+		if cur.ID == id {
+			s.data.Planes = append(s.data.Planes[:i], s.data.Planes[i+1:]...)
+			return true, s.saveLocked()
+		}
+	}
+	return false, nil
+}
+
+// AddRecord 追加一条推送记录（只动这一个数据面，互不影响）。
+func (s *Store) AddRecord(id string, rec PushRecord) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.loadLocked()
+	for i := range s.data.Planes {
+		if s.data.Planes[i].ID != id {
+			continue
+		}
+		l := append(s.data.Planes[i].Log, rec)
+		if len(l) > MaxLog {
+			l = l[len(l)-MaxLog:]
+		}
+		s.data.Planes[i].Log = l
+		return s.saveLocked()
+	}
+	return nil
+}
+
+// SetFixed 保存固定域名的最近测速记录（整体覆盖，只作记录）。
+func (s *Store) SetFixed(recs map[string]FixedRecord) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.loadLocked()
+	s.data.Fixed = recs
+	return s.saveLocked()
+}
+
+// FixedRecords 返回固定域名的最近测速记录（按 FixedDomains 顺序，没测过的也占位）。
+func (s *Store) FixedRecords() []FixedRecord {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.loadLocked()
+	out := make([]FixedRecord, 0, len(FixedDomains))
+	for _, d := range FixedDomains {
+		if r, ok := s.data.Fixed[d]; ok {
+			out = append(out, r)
+		} else {
+			out = append(out, FixedRecord{Domain: d, Note: "尚未测速"})
+		}
+	}
+	return out
+}
diff --git a/packages/desktop/internal/dpreg/dpreg_test.go b/packages/desktop/internal/dpreg/dpreg_test.go
new file mode 100644
index 0000000..0ead2d8
--- /dev/null
+++ b/packages/desktop/internal/dpreg/dpreg_test.go
@@ -0,0 +1,109 @@
+package dpreg
+
+import (
+	"os"
+	"path/filepath"
+	"regexp"
+	"testing"
+)
+
+// 固定域名 Go 端与内核端必须一致，否则「记录的」和「实际进订阅的」会对不上。
+func TestFixedDomainsMatchKernel(t *testing.T) {
+	raw, err := os.ReadFile(filepath.Join("..", "..", "..", "worker-core", "src", "data", "pools.ts"))
+	if err != nil {
+		t.Skip("找不到内核源码（单独编译 desktop 时跳过）：", err)
+	}
+	m := regexp.MustCompile(`(?s)FIXED_PREFERRED_DOMAINS: readonly string\[\] = \[(.*?)\]`).FindSubmatch(raw)
+	if m == nil {
+		t.Fatal("内核里没有 FIXED_PREFERRED_DOMAINS")
+	}
+	var kernel []string
+	for _, x := range regexp.MustCompile(`'([^']+)'`).FindAllSubmatch(m[1], -1) {
+		kernel = append(kernel, string(x[1]))
+	}
+	if len(kernel) != len(FixedDomains) {
+		t.Fatalf("数量不一致：内核 %d，Go %d", len(kernel), len(FixedDomains))
+	}
+	for i := range kernel {
+		if kernel[i] != FixedDomains[i] {
+			t.Fatalf("第 %d 个不一致：内核 %s，Go %s", i, kernel[i], FixedDomains[i])
+		}
+	}
+}
+
+func TestUpsertIsolationAndDedup(t *testing.T) {
+	s := New(t.TempDir())
+	a, err := s.Upsert(DataPlane{ID: "dp-a", Name: "A", ProfileID: "acc_1", Domain: "a.example.com", UUID: "u1", Enabled: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if a.WSPath != "/" || a.TrojanPath != "/trojan" || a.XHTTPPath != "/xhttp" {
+		t.Fatalf("路径默认值不对：%+v", a)
+	}
+	if _, err := s.Upsert(DataPlane{ID: "dp-b", Name: "B", ProfileID: "acc_2", Domain: "b.example.com", UUID: "u2", Enabled: true}); err != nil {
+		t.Fatal(err)
+	}
+	// 同账号同域名不能重复登记
+	if _, err := s.Upsert(DataPlane{ID: "dp-c", Name: "C", ProfileID: "acc_1", Domain: "a.example.com", UUID: "u3"}); err == nil {
+		t.Fatal("同账号同域名应该被拒绝")
+	}
+	// 非法域名 / 缺 UUID / 非法 id
+	if _, err := s.Upsert(DataPlane{ID: "dp-d", ProfileID: "acc_1", Domain: "bad domain", UUID: "x"}); err == nil {
+		t.Fatal("非法域名应该被拒绝")
+	}
+	if _, err := s.Upsert(DataPlane{ID: "dp-d", ProfileID: "acc_1", Domain: "d.example.com"}); err == nil {
+		t.Fatal("缺 UUID 应该被拒绝")
+	}
+	if _, err := s.Upsert(DataPlane{ID: "Bad_ID", ProfileID: "acc_1", Domain: "d.example.com", UUID: "x"}); err == nil {
+		t.Fatal("非法 id 应该被拒绝")
+	}
+	// 推送记录只写进自己，互不影响；更新保留记录
+	_ = s.AddRecord("dp-a", PushRecord{Status: "failed", Message: "x"})
+	_ = s.AddRecord("dp-b", PushRecord{Status: "ok"})
+	pa, _ := s.Get("dp-a")
+	pb, _ := s.Get("dp-b")
+	if len(pa.Log) != 1 || pa.Log[0].Status != "failed" || len(pb.Log) != 1 || pb.Log[0].Status != "ok" {
+		t.Fatalf("记录串了：%+v / %+v", pa.Log, pb.Log)
+	}
+	pa.Name = "A2"
+	if _, err := s.Upsert(pa); err != nil {
+		t.Fatal(err)
+	}
+	if pa2, _ := s.Get("dp-a"); len(pa2.Log) != 1 || pa2.Name != "A2" {
+		t.Fatalf("更新应保留记录：%+v", pa2)
+	}
+}
+
+func TestPersistAndSettingsDefaults(t *testing.T) {
+	dir := t.TempDir()
+	s := New(dir)
+	set := s.Settings()
+	if !set.PushAfterAdd || !set.PushAfterScan || set.Mode != "append" || set.Top != 15 {
+		t.Fatalf("默认设置不对：%+v", set)
+	}
+	_, _ = s.Upsert(DataPlane{ID: "dp-a", ProfileID: "acc_1", Domain: "a.example.com", UUID: "u1", Enabled: true})
+	// 重新打开能读回来，文件权限 0600
+	s2 := New(dir)
+	if len(s2.List()) != 1 {
+		t.Fatal("重启后数据丢失")
+	}
+	if st, err := os.Stat(filepath.Join(dir, Filename)); err != nil || st.Mode().Perm() != 0o600 {
+		t.Fatalf("文件权限不对：%v %v", st, err)
+	}
+	if ok, _ := s2.Delete("dp-a"); !ok || len(s2.List()) != 0 {
+		t.Fatal("删除失败")
+	}
+}
+
+func TestFixedRecordsPlaceholder(t *testing.T) {
+	s := New(t.TempDir())
+	recs := s.FixedRecords()
+	if len(recs) != len(FixedDomains) || recs[0].Note != "尚未测速" {
+		t.Fatalf("占位记录不对：%+v", recs)
+	}
+	_ = s.SetFixed(map[string]FixedRecord{FixedDomains[1]: {Domain: FixedDomains[1], OK: true, LatencyMs: 80}})
+	recs = s.FixedRecords()
+	if !recs[1].OK || recs[1].LatencyMs != 80 || recs[0].Note != "尚未测速" {
+		t.Fatalf("记录不对：%+v", recs)
+	}
+}
diff --git a/packages/desktop/internal/scan/callback.go b/packages/desktop/internal/scan/callback.go
index 4c8f7bf..d57e6b3 100644
--- a/packages/desktop/internal/scan/callback.go
+++ b/packages/desktop/internal/scan/callback.go
@@ -122,3 +122,155 @@ func DefaultCallbackURL(host string) string {
 	host = strings.TrimRight(host, "/")
 	return host + "/api/v1/preferred-ips"
 }
+
+// DPResult 是向某个数据面推送的结果（含内核回报的写入统计）。
+type DPResult struct {
+	CallbackResult
+	// Retryable 表示失败值得重试（网络错误 / 5xx / 429）；4xx 业务错误不重试。
+	Retryable bool
+	Count     int // 推送后该数据面池内条数
+	Added     int // 本次新增（去重后）
+	Removed   int // 本次删除
+}
+
+// PostResultsDP 把一批 IP 推送到**某一个数据面**的独立优选池（1:N）。
+//
+// mode：append（增量，去重）/ replace（整体替换）/ remove（按 ip:port 删除）。
+// 只写 dp 指定的那个池，不碰全局池，也不影响其它数据面。
+func PostResultsDP(ctx context.Context, callbackURL, token, dpID string, entries []string, mode string, timeout time.Duration) DPResult {
+	if timeout <= 0 {
+		timeout = 20 * time.Second
+	}
+	if mode != "append" && mode != "remove" {
+		mode = "replace"
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	body, err := json.Marshal(map[string]any{"ips": entries, "mode": mode, "target": "local", "dp": dpID})
+	if err != nil {
+		return DPResult{CallbackResult: CallbackResult{Error: err.Error()}}
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, callbackURL, bytes.NewReader(body))
+	if err != nil {
+		return DPResult{CallbackResult: CallbackResult{Error: err.Error()}}
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Authorization", "Bearer "+token)
+	req.Header.Set("User-Agent", "CFPilot-Desktop/1.0")
+	res, err := http.DefaultClient.Do(req)
+	if err != nil {
+		return DPResult{CallbackResult: CallbackResult{Error: err.Error()}, Retryable: true}
+	}
+	defer func() { _ = res.Body.Close() }()
+	raw, _ := io.ReadAll(io.LimitReader(res.Body, 64<<10))
+	if res.StatusCode < 200 || res.StatusCode >= 300 {
+		msg := strings.TrimSpace(string(raw))
+		if len(msg) > 300 {
+			msg = msg[:300]
+		}
+		if msg == "" {
+			msg = fmt.Sprintf("HTTP %d", res.StatusCode)
+		} else {
+			msg = fmt.Sprintf("HTTP %d %s", res.StatusCode, msg)
+		}
+		return DPResult{
+			CallbackResult: CallbackResult{Status: res.StatusCode, Error: msg},
+			Retryable:      res.StatusCode >= 500 || res.StatusCode == 429,
+		}
+	}
+	var out struct {
+		Count   int `json:"count"`
+		Added   int `json:"added"`
+		Removed int `json:"removed"`
+	}
+	_ = json.Unmarshal(raw, &out)
+	return DPResult{
+		CallbackResult: CallbackResult{OK: true, Status: res.StatusCode},
+		Count:          out.Count, Added: out.Added, Removed: out.Removed,
+	}
+}
+
+// RegistryItem 是同步到控制面的数据面描述（只含渲染订阅所需字段）。
+type RegistryItem struct {
+	ID             string `json:"id"`
+	Name           string `json:"name"`
+	Domain         string `json:"domain"`
+	UUID           string `json:"uuid"`
+	WSPath         string `json:"wsPath"`
+	TrojanPassword string `json:"trojanPassword"`
+	TrojanPath     string `json:"trojanPath"`
+	XHTTPPath      string `json:"xhttpPath"`
+	Enabled        bool   `json:"enabled"`
+}
+
+// DataplanesURL 由控制面域名推导注册表接口地址。
+func DataplanesURL(host string) string {
+	return strings.TrimSuffix(DefaultCallbackURL(host), "/preferred-ips") + "/dataplanes"
+}
+
+// PutRegistry 把数据面注册表同步到控制面（扫描令牌鉴权）。
+func PutRegistry(ctx context.Context, host, token string, items []RegistryItem, timeout time.Duration) CallbackResult {
+	if timeout <= 0 {
+		timeout = 20 * time.Second
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	body, err := json.Marshal(map[string]any{"items": items})
+	if err != nil {
+		return CallbackResult{Error: err.Error()}
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPut, DataplanesURL(host), bytes.NewReader(body))
+	if err != nil {
+		return CallbackResult{Error: err.Error()}
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Authorization", "Bearer "+token)
+	req.Header.Set("User-Agent", "CFPilot-Desktop/1.0")
+	res, err := http.DefaultClient.Do(req)
+	if err != nil {
+		return CallbackResult{Error: err.Error()}
+	}
+	defer func() { _ = res.Body.Close() }()
+	if res.StatusCode < 200 || res.StatusCode >= 300 {
+		raw, _ := io.ReadAll(io.LimitReader(res.Body, 300))
+		return CallbackResult{Status: res.StatusCode, Error: fmt.Sprintf("HTTP %d %s", res.StatusCode, strings.TrimSpace(string(raw)))}
+	}
+	return CallbackResult{OK: true, Status: res.StatusCode}
+}
+
+// PoolCounts 读取控制面上各数据面独立池的条数（扫描令牌鉴权）。
+func PoolCounts(ctx context.Context, host, token string, timeout time.Duration) (map[string]int, error) {
+	if timeout <= 0 {
+		timeout = 15 * time.Second
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, DataplanesURL(host), nil)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Authorization", "Bearer "+token)
+	req.Header.Set("User-Agent", "CFPilot-Desktop/1.0")
+	res, err := http.DefaultClient.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = res.Body.Close() }()
+	if res.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("HTTP %d", res.StatusCode)
+	}
+	var out struct {
+		Items []struct {
+			ID        string `json:"id"`
+			PoolCount int    `json:"poolCount"`
+		} `json:"items"`
+	}
+	if err := json.NewDecoder(io.LimitReader(res.Body, 1<<20)).Decode(&out); err != nil {
+		return nil, err
+	}
+	m := map[string]int{}
+	for _, it := range out.Items {
+		m[it.ID] = it.PoolCount
+	}
+	return m, nil
+}
